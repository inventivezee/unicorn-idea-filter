# --- AI providers (set at least one) ---------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Supabase (public database + accounts) ---------------------------------
# Leave ALL THREE unset to run the app in local-only mode (no cloud features).
# Values: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ($19/month subscription) ----------------------------------------
# Optional until you want billing. See SETUP.md for the product/webhook steps.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- App --------------------------------------------------------------------
# Public URL of the deployment (Stripe redirects), e.g. https://ideas.example.com
NEXT_PUBLIC_APP_URL=
# Comma-separated emails that get the admin console after signing in.
ADMIN_EMAILS=

# --- Email notifications (Resend) --------------------------------------------
# Sends "your custom filter is ready / failed" mails when the background
# design chain finishes. Leave unset to skip emails silently.
# EMAIL_FROM must be a sender on a domain you verified in Resend, e.g.
#   Unicorn Idea Filter <hello@yourdomain.com>
# (unset EMAIL_FROM falls back to Resend's onboarding sender, which only
# delivers to your own Resend account email — fine for testing).
RESEND_API_KEY=
EMAIL_FROM=

# --- Database migrations (LOCAL DEV ONLY — do NOT set this in Vercel) --------
# A Supabase Personal Access Token lets `npm run migrate` apply
# supabase/migrations/*.sql to the remote database via the Management API,
# instead of pasting SQL into the dashboard editor. Create one at:
#   https://supabase.com/dashboard/account/tokens
# Keep it only in .env.local (gitignored). It is a user-scoped token — it can
# reach every project your Supabase account can access, so treat it like a
# password and never commit or deploy it.
SUPABASE_ACCESS_TOKEN=
# Optional — the runner derives this from NEXT_PUBLIC_SUPABASE_URL if unset.
SUPABASE_PROJECT_REF=
